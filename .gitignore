# Operating System files
.DS_Store
Thumbs.db
*.tmp

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Environment files (NEVER commit secrets to production)
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Backend Go binaries & uploads
backend/server.exe
backend/server
backend/bin/
backend/uploads/*
!backend/uploads/.gitkeep

# Frontend Node dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Docker local overrides
docker-compose.override.yml
