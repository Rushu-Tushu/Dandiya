# Frontend Production & Development Environment Variables

# Backend API Base URL
# For Local Dev: leave empty to use Vite proxy (default: http://localhost:8080)
# For Vercel Production: set to your deployed backend URL (e.g. https://dandiya-api.onrender.com)
VITE_API_URL=https://your-backend-api.onrender.com

# Backend Realtime WebSocket URL (Optional)
# If left empty, Dandiya +1 will automatically derive it from VITE_API_URL (http -> ws, https -> wss)
# Example: wss://your-backend-api.onrender.com
# VITE_WS_URL=wss://your-backend-api.onrender.com
